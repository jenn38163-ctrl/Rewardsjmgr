{
  "name": "rewards-gateway-backend",
  "version": "1.0.0",
  "description": "Enterprise Rewards Gateway Backend with Double-Entry Ledger and API Resilience",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "tsc-watch --onSuccess \"node dist/src/main.js\"",
    "db:migrate": "node dist/src/db/migrate.js",
    "db:seed": "node dist/src/db/seed.js",
    "test": "jest",
    "test:ledger": "jest dist/src/ledger/ledger.spec.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/swagger": "^7.1.17",
    "drizzle-orm": "^0.29.3",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "firebase-admin": "^12.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "dotenv": "^16.3.1",
    "@zenditplatform/zendit-sdk": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "tsc-watch": "^6.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  }
}
